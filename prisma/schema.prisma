// Moove — modelo de dados
// Convenção: campos em camelCase no Prisma/TypeScript, mapeados para snake_case
// no banco (@map / @@map) para bater exatamente com os nomes de coluna do
// modelo de dados especificado no escopo do produto.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum StatusConta {
  ATIVA
  SUSPENSA

  @@map("status_conta")
}

enum StatusConvite {
  PENDENTE
  USADO
  EXPIRADO
  REVOGADO

  @@map("status_convite")
}

enum StatusVinculo {
  ATIVO
  REVOGADO

  @@map("status_vinculo")
}

// CODIGO = fluxo antigo (motorista gera um código de 8 caracteres e
// compartilha por fora; o responsável já precisa ter conta própria pra
// usá-lo). NOMINAL = fluxo novo (motorista já pré-cadastra os dados do
// responsável e do aluno; o responsável só completa o próprio cadastro,
// confirma o endereço e assina o contrato — o vínculo é criado sozinho na
// assinatura, ver ContratoTransporte.assinadoEm).
enum TipoConvite {
  CODIGO
  NOMINAL

  @@map("tipo_convite")
}

enum CicloCobrancaAssinatura {
  MENSAL
  SEMESTRAL
  ANUAL

  @@map("ciclo_cobranca_assinatura")
}

enum StatusAssinatura {
  TESTE
  ATIVA
  EXPIRADA
  CANCELADA

  @@map("status_assinatura")
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO

  @@map("status_pagamento")
}

enum PublicoPlano {
  MOTORISTA
  RESPONSAVEL

  @@map("publico_plano")
}

// Status do aluno na rota de um dia específico — marcado pelo motorista no
// painel de rota. Existe só o registro do dia em que houve uma marcação
// (sem registro = "normal", nem embarcou nem foi marcado ausente ainda).
enum StatusEmbarqueDia {
  EMBARCOU
  AUSENTE

  @@map("status_embarque_dia")
}

// Perna da rota do dia: IDA (buscar o aluno em casa e levar pra escola) ou
// VOLTA (buscar o aluno na escola e levar pra casa) — ver botão "Retorno"
// em RotaPanel.tsx. Cada vínculo pode ter uma marcação de embarque
// independente por perna (ver EmbarqueDia.@@unique abaixo).
enum SentidoViagem {
  IDA
  VOLTA

  @@map("sentido_viagem")
}

enum StatusCobrancaAluno {
  PENDENTE
  PAGO
  CANCELADO

  @@map("status_cobranca_aluno")
}

enum GeneroAluno {
  MASCULINO
  FEMININO
  OUTRO

  @@map("genero_aluno")
}

enum TurnoEscolar {
  MANHA
  TARDE
  INTEGRAL
  NOITE

  @@map("turno_escolar")
}

enum StatusMensalidadeTransporte {
  PENDENTE
  PAGO
  CANCELADO

  @@map("status_mensalidade_transporte")
}

// ---------------------------------------------------------------------------
// Motorista
// ---------------------------------------------------------------------------

model Motorista {
  id           String      @id @default(cuid())
  nome         String
  email        String      @unique
  telefone     String
  // Único (quando preenchido) — impede que a mesma pessoa crie mais de uma
  // conta de motorista. Nullable porque contas criadas antes desse campo
  // existir não têm CPF; cadastros novos são obrigados a preencher (ver
  // motoristaRegisterSchema).
  cpf          String?     @unique
  senhaHash    String      @map("senha_hash")
  statusConta  StatusConta @default(ATIVA) @map("status_conta")

  // LGPD: registro do aceite explícito no cadastro.
  consentimentoLgpdAceitoEm DateTime @map("consentimento_lgpd_aceito_em")

  // Confirmado no momento do cadastro (a conta só existe depois do código de
  // verificação por e-mail ser validado) e reforçado a cada login, já que o
  // login também exige um código novo enviado por e-mail.
  emailVerificadoEm DateTime? @map("email_verificado_em")

  // Teste grátis de 7 dias, contado a partir do cadastro — dá acesso total
  // ao sistema sem precisar escolher/pagar um plano. Só depois que essa data
  // passa (e sem uma Assinatura ATIVA) o motorista é bloqueado e direcionado
  // para a tela de planos (ver `motoristaTemAcesso` em subscription/service.ts).
  testeExpiraEm DateTime @map("teste_expira_em")

  // Quantos minutos de antecedência (estimados) disparam o alerta sonoro de
  // chegada pro responsável — configurável pelo motorista (ver
  // LocationSharingPanel.tsx e POST /api/motorista/localizacao, que checa
  // isso a cada atualização de GPS).
  alertaChegadaMinutos Int @default(5) @map("alerta_chegada_minutos")

  // Chave PIX do próprio motorista — usada só pra montar a mensagem de
  // WhatsApp de cobrança por aluno (ver src/components/motorista/
  // WhatsAppCobrancaButton.tsx e módulo de gestão de alunos). Texto livre
  // (CPF/CNPJ/e-mail/telefone/chave aleatória) porque o pagamento é
  // combinado diretamente entre motorista e responsável — a plataforma não
  // processa esse valor, só facilita o envio da cobrança.
  chavePix String? @map("chave_pix")

  // Isenção de cobrança aplicada manualmente pelo admin (/admin/motoristas)
  // — motorista nunca é bloqueado por assinatura vencida, independente do
  // status dela (ver `motoristaTemAcesso`). Uso: cortesia/parceria. Não
  // afeta a cobrança por aluno (CobrancaAluno), que é combinada direto
  // entre motorista e responsável, fora da Asaas.
  isentoCobranca Boolean @default(false) @map("isento_cobranca")

  // Data/hora do último login concluído (POST .../login/verificar) — exibido
  // na listagem do admin. Fica null pra contas que não logaram desde que
  // esse campo foi adicionado.
  ultimoAcessoEm DateTime? @map("ultimo_acesso_em")

  criadoEm DateTime @default(now()) @map("criado_em")

  veiculos             Veiculo[]
  convites             Convite[]
  vinculos             Vinculo[]
  localizacao          Localizacao?
  assinaturas          Assinatura[]
  escolas              Escola[]
  percursos            PercursoDia[]
  cobrancasAluno       CobrancaAluno[]
  pushSubscriptions    PushSubscription[]
  mensalidadesTransporte MensalidadeTransporte[]

  @@map("motoristas")
}

// ---------------------------------------------------------------------------
// Veiculo
// ---------------------------------------------------------------------------

model Veiculo {
  id            String   @id @default(cuid())
  motoristaId   String   @map("motorista_id")
  placa         String
  modelo        String
  documentoUrl  String?  @map("documento_url")
  criadoEm      DateTime @default(now()) @map("criado_em")

  motorista Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)

  // A busca do responsável é feita por placa; garantimos unicidade global
  // (normalizada em maiúsculas/sem espaços na aplicação) e um índice de busca.
  @@unique([placa])
  @@index([motoristaId])
  @@map("veiculos")
}

// ---------------------------------------------------------------------------
// Responsavel
// ---------------------------------------------------------------------------

model Responsavel {
  id          String      @id @default(cuid())
  nome        String
  email       String      @unique
  telefone    String
  // Único (quando preenchido) — mesma regra do Motorista.cpf: impede
  // cadastro duplicado da mesma pessoa como responsável.
  cpf         String?     @unique
  senhaHash   String      @map("senha_hash")
  statusConta StatusConta @default(ATIVA) @map("status_conta")

  // LGPD: registro do aceite explícito no cadastro.
  consentimentoLgpdAceitoEm DateTime @map("consentimento_lgpd_aceito_em")

  emailVerificadoEm DateTime? @map("email_verificado_em")

  // Vestígio do antigo modelo de cobrança por responsável (removido — quem
  // paga por aluno agora é o motorista, ver `CobrancaAluno`). Mantido só
  // porque `testeExpiraEm` é obrigatório e usado em outros lugares da UI
  // (ex: banner de boas-vindas); não bloqueia mais nada de fato —
  // `responsavelTemAcesso` em subscription/service.ts sempre retorna true.
  testeExpiraEm DateTime @map("teste_expira_em")

  criadoEm DateTime @default(now()) @map("criado_em")

  vinculos        Vinculo[]
  convitesUsados  Convite[] @relation("ConviteUsadoPor")
  alunos          Aluno[]
  pushSubscriptions PushSubscription[]

  @@map("responsaveis")
}

// ---------------------------------------------------------------------------
// PushSubscription — inscrição de push (Web Push API) de um navegador/
// dispositivo do responsável, usada pro alerta sonoro de proximidade. Um
// responsável pode ter mais de uma (celular + computador, por exemplo).
// ---------------------------------------------------------------------------

// Generalizada pra também aceitar motorista (originalmente só existia pro
// alerta de chegada do responsável) — usada agora também pra avisar o
// motorista de eventos como convite aceito e cobrança de aluno gerada (ver
// src/lib/push/notificar.ts). Exatamente um dos dois ids é preenchido,
// nunca os dois nem nenhum — checado na aplicação (não dá pra expressar
// XOR em constraint do Postgres sem trigger, não vale a complexidade aqui).
model PushSubscription {
  id            String   @id @default(cuid())
  responsavelId String?  @map("responsavel_id")
  motoristaId   String?  @map("motorista_id")
  endpoint      String   @unique
  p256dh        String
  auth          String
  criadoEm      DateTime @default(now()) @map("criado_em")

  responsavel Responsavel? @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  motorista   Motorista?   @relation(fields: [motoristaId], references: [id], onDelete: Cascade)

  @@index([responsavelId])
  @@index([motoristaId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// Escola — cadastrada pelo motorista (pode atender mais de uma). Endereço
// geocodificado do mesmo jeito que o do responsável, usado pelo motorista
// pra traçar rota direto até a escola (ver src/lib/routing/osrm.ts).
// ---------------------------------------------------------------------------

model Escola {
  id          String @id @default(cuid())
  motoristaId String @map("motorista_id")
  nome        String

  cep         String? @map("cep")
  logradouro  String? @map("logradouro")
  numero      String? @map("numero")
  complemento String? @map("complemento")
  bairro      String? @map("bairro")
  cidade      String? @map("cidade")
  estado      String? @map("estado")

  enderecoLatitude  Float? @map("endereco_latitude")
  enderecoLongitude Float? @map("endereco_longitude")

  // Ver comentário equivalente em Responsavel — mesmo padrão de "texto
  // encontrado" + "confirmado por humano" + "precisão baixa" pra escolas.
  enderecoTextoEncontrado String?  @map("endereco_texto_encontrado")
  enderecoConfirmado      Boolean  @default(false) @map("endereco_confirmado")
  enderecoPrecisaoBaixa   Boolean  @default(false) @map("endereco_precisao_baixa")

  criadoEm DateTime @default(now()) @map("criado_em")

  motorista Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  vinculos  Vinculo[]

  @@index([motoristaId])
  @@map("escolas")
}

// ---------------------------------------------------------------------------
// Aluno — cadastrado pelo responsável, antes de qualquer vínculo com
// motorista. É a unidade cobrada na assinatura do responsável (1 assento =
// 1 aluno) e a unidade do vínculo (ver Vinculo.alunoId) — um responsável com
// 2 filhos tem 2 Alunos, podendo vincular cada um a um motorista diferente.
// ---------------------------------------------------------------------------

model Aluno {
  id            String @id @default(cuid())
  responsavelId String @map("responsavel_id")
  nome          String

  // Preenchidos no cadastro do responsável (opcional lá) ou completados
  // depois pelo motorista na tela de perfil do aluno — não são exigidos em
  // nenhum dos dois fluxos, por isso nullable.
  dataNascimento DateTime?    @map("data_nascimento")
  genero         GeneroAluno?

  // Endereço de embarque/desembarque DESTE aluno — cada filho de um mesmo
  // responsável pode ter um endereço diferente (ex.: escolas diferentes),
  // por isso o endereço fica no Aluno e não mais no Responsavel. Preenchido
  // pelo responsável no cadastro/edição do aluno ("Meus alunos") a partir do
  // CEP (autocompletado via ViaCEP). `numero` e `complemento` continuam
  // sendo digitados manualmente.
  cep           String? @map("cep")
  logradouro    String? @map("logradouro")
  numero        String? @map("numero")
  complemento   String? @map("complemento")
  bairro        String? @map("bairro")
  cidade        String? @map("cidade")
  estado        String? @map("estado") // UF, 2 letras

  // Geocodificado a partir do endereço acima (LocationIQ/Nominatim/
  // BrasilAPI) — é o que a rota otimizada do motorista usa como parada para
  // este aluno. Pode ficar nulo se a geocodificação falhar (endereço não
  // encontrado); a tela de edição do aluno deixa isso visível e permite
  // tentar de novo.
  enderecoLatitude  Float?    @map("endereco_latitude")
  enderecoLongitude Float?    @map("endereco_longitude")
  enderecoAtualizadoEm DateTime? @map("endereco_atualizado_em")

  // Texto do lugar que o provedor de geocodificação resolveu (ex.: "Avenida
  // Resedá, Portais, Cajamar - SP") — mostrado na UI ao lado do pino pra
  // facilitar comparar com o endereço digitado sem precisar dar zoom no
  // mapa. `enderecoConfirmado` só vira true quando a PESSOA efetivamente
  // confirmou/ajustou o pino manualmente (ver PATCH .../coordenadas) — um
  // endereço "geocodificado com sucesso" não é o mesmo que "conferido por
  // humano", e é essa lacuna que causa pino em lugar errado sem ninguém
  // perceber até o motorista já estar na rota.
  enderecoTextoEncontrado String?  @map("endereco_texto_encontrado")
  enderecoConfirmado      Boolean  @default(false) @map("endereco_confirmado")

  // true quando a coordenada veio de uma etapa de baixa confiança (texto
  // livre ou centro do CEP via BrasilAPI) — ver `GeocodeResult.precisao` em
  // src/lib/geocoding.ts. Usado pra UI insistir mais na confirmação manual
  // nesses casos, já que a coordenada pode estar em outra rua da região
  // mesmo com o texto do endereço batendo certinho.
  enderecoPrecisaoBaixa Boolean @default(false) @map("endereco_precisao_baixa")

  criadoEm DateTime @default(now()) @map("criado_em")

  responsavel Responsavel @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  vinculos    Vinculo[]

  @@index([responsavelId])
  @@map("alunos")
}

// ---------------------------------------------------------------------------
// Convite
// ---------------------------------------------------------------------------

model Convite {
  id          String        @id @default(cuid())
  codigo      String        @unique
  motoristaId String        @map("motorista_id")
  tipo        TipoConvite   @default(CODIGO)
  status      StatusConvite @default(PENDENTE)
  criadoEm    DateTime      @default(now()) @map("criado_em")
  expiraEm    DateTime      @map("expira_em")

  usadoPorResponsavelId String?      @map("usado_por_responsavel_id")
  usadoEm               DateTime?    @map("usado_em")

  // Preenchidos só quando `tipo = NOMINAL` — dados que o motorista já
  // digitou sobre o responsável e o aluno (ver POST
  // /api/motorista/convites/nominal), usados pra pré-preencher o cadastro
  // do responsável e criar o vínculo automaticamente assim que ele assina o
  // contrato (ver POST .../convites/nominal/[codigo]/assinar). `dadosAluno`
  // guarda nome/nascimento/gênero/escola/período/mensalidade/prazo do
  // contrato — mesmo formato usado por editarPerfilAlunoSchema, só que
  // ainda não existe Aluno nem Vinculo nesse momento.
  nomeResponsavel     String? @map("nome_responsavel")
  emailResponsavel    String? @map("email_responsavel")
  telefoneResponsavel String? @map("telefone_responsavel")
  cpfResponsavel      String? @map("cpf_responsavel")
  dadosAluno          Json?   @map("dados_aluno")

  // Preenchido em .../nominal/[codigo]/verificar, quando a conta do
  // responsável e o Aluno (a partir de `dadosAluno`) já foram criados, mas
  // o contrato ainda não foi assinado — é a ponte entre esse passo e
  // .../assinar, que cria o Vinculo de fato. Sem relação formal do Prisma de
  // propósito (é só uma referência de aplicação, não precisa de join).
  alunoIdNominal String? @map("aluno_id_nominal")

  motorista        Motorista    @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  usadoPorResponsavel Responsavel? @relation("ConviteUsadoPor", fields: [usadoPorResponsavelId], references: [id])
  vinculo           Vinculo?

  @@index([motoristaId])
  @@map("convites")
}

// ---------------------------------------------------------------------------
// Vinculo
// ---------------------------------------------------------------------------

model Vinculo {
  id            String        @id @default(cuid())
  motoristaId   String        @map("motorista_id")
  responsavelId String        @map("responsavel_id")
  // O vínculo é por aluno (não mais por família inteira) — cada aluno
  // pago pelo responsável gera um vínculo próprio, podendo ser com
  // motoristas diferentes. `responsavelId` continua aqui (redundante com
  // `aluno.responsavelId`) porque é usado direto nas checagens de
  // segurança/autorização sem precisar de join extra.
  //
  // NÃO é @unique: um aluno pode ter vários vínculos ao longo do tempo
  // (histórico de troca/revogação de motorista) — só não pode ter mais de
  // um com status ATIVO ao mesmo tempo, checado na aplicação (mesmo padrão
  // já usado para motorista+responsável antes desta mudança).
  alunoId       String        @map("aluno_id")
  // Escola desse aluno com esse motorista, escolhida ao usar o convite
  // (dentre as escolas cadastradas pelo motorista). Opcional só por
  // segurança de migração — todo vínculo novo sempre define uma.
  escolaId      String?       @map("escola_id")
  conviteId     String        @unique @map("convite_id")
  status        StatusVinculo @default(ATIVO)
  criadoEm      DateTime      @default(now()) @map("criado_em")
  revogadoEm    DateTime?     @map("revogado_em")

  // Próximo "corte" de 30 dias desse vínculo, avaliado pelo cron de
  // cobrança (ver src/lib/subscription/cobranca-aluno.ts): a cada vez que
  // essa data chega, o sistema decide se esse aluno está dentro da faixa
  // grátis do plano do motorista ou se gera uma `CobrancaAluno` — e SEMPRE
  // reagenda +30 dias, mesmo quando não cobra. Null só nunca deveria
  // acontecer para vínculos ATIVOS (setado na criação/reativação); vínculo
  // REVOGADO simplesmente para de ser avaliado (nunca cobra período
  // incompleto — ver comentário na função de cobrança).
  proximaCobrancaEm DateTime? @map("proxima_cobranca_em")

  // Turno escolar desse aluno nessa rota — informativo, preenchido pelo
  // motorista na tela de perfil (ver imagem de referência "Dados
  // escolares"). Não afeta cálculo de cobrança nenhuma.
  periodo TurnoEscolar? @map("periodo")

  // Termos da mensalidade de TRANSPORTE combinada entre motorista e
  // responsável — dinheiro que vai direto pro motorista, fora da
  // plataforma (bem diferente da CobrancaAluno, que é a taxa da Moove por
  // aluno excedente do plano). Preenchidos pelo motorista; enquanto
  // `valorMensalidade` for null, nenhuma MensalidadeTransporte é gerada
  // pro cron (ver src/lib/mensalidade/mensalidade-transporte.ts).
  valorMensalidade        Decimal?  @db.Decimal(10, 2) @map("valor_mensalidade")
  diaPagamentoMensalidade Int?      @map("dia_pagamento_mensalidade") // 1–31
  vigenciaInicio          DateTime? @map("vigencia_inicio") // primeiro dia do mês de início
  vigenciaFim             DateTime? @map("vigencia_fim") // primeiro dia do mês final (null = sem prazo definido)

  motorista   Motorista   @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  responsavel Responsavel @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  aluno       Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  escola      Escola?     @relation(fields: [escolaId], references: [id])
  convite     Convite     @relation(fields: [conviteId], references: [id])
  embarquesDia EmbarqueDia[]
  alertasProximidade AlertaProximidade[]
  cobrancas   CobrancaAluno[]
  mensalidades MensalidadeTransporte[]
  contratos    ContratoTransporte[]

  // Índice usado pela checagem crítica de segurança: existe vínculo ATIVO
  // entre este responsável e este motorista?
  @@index([motoristaId, responsavelId, status])
  @@index([responsavelId, status])
  @@index([alunoId, status])
  @@index([escolaId])
  @@map("vinculos")
}

// ---------------------------------------------------------------------------
// MensalidadeTransporte — cobrança mensal do transporte em si (o serviço
// prestado pelo motorista à família), gerada automaticamente a partir dos
// termos definidos no Vinculo (valorMensalidade/diaPagamentoMensalidade/
// vigência). Dinheiro combinado direto entre motorista e responsável, por
// isso o controle aqui é manual (PENDENTE até o motorista confirmar que
// recebeu) — mesmo espírito do antigo fluxo de CobrancaAluno via WhatsApp,
// só que essa aqui é intencionalmente peer-to-peer e nunca vai passar pela
// Asaas.
// ---------------------------------------------------------------------------

model MensalidadeTransporte {
  id            String   @id @default(cuid())
  vinculoId     String   @map("vinculo_id")
  // Redundante com vinculo.motoristaId de propósito — mesma razão do
  // padrão já usado em CobrancaAluno (consulta simples sem join extra).
  motoristaId   String   @map("motorista_id")
  // Sempre o dia 1 do mês de referência (ex.: 2026-08-01) — facilita
  // comparar/ordenar sem se preocupar com o dia exato de vencimento.
  mesReferencia DateTime @map("mes_referencia")
  valor         Decimal  @db.Decimal(10, 2)
  status        StatusMensalidadeTransporte @default(PENDENTE)
  pagoEm        DateTime? @map("pago_em")
  criadoEm      DateTime @default(now()) @map("criado_em")

  vinculo   Vinculo   @relation(fields: [vinculoId], references: [id], onDelete: Cascade)
  motorista Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)

  // Nunca gerar duas mensalidades pro mesmo mês do mesmo vínculo, mesmo se
  // o cron rodar mais de uma vez no dia.
  @@unique([vinculoId, mesReferencia])
  @@index([motoristaId, status])
  @@map("mensalidades_transporte")
}

// ---------------------------------------------------------------------------
// ContratoTransporte — registro do combinado de prestação de serviço entre
// motorista e responsável pra aquele aluno. Texto livre + link opcional
// (não há upload de arquivo no sistema — se o motorista já tem um PDF
// assinado em outro lugar, cola o link aqui). Histórico: pode haver mais de
// um ao longo do tempo (renovações, reajustes).
// ---------------------------------------------------------------------------

model ContratoTransporte {
  id             String    @id @default(cuid())
  vinculoId      String    @map("vinculo_id")
  titulo         String
  observacoes    String?
  arquivoUrl     String?   @map("arquivo_url")
  vigenciaInicio DateTime? @map("vigencia_inicio")
  vigenciaFim    DateTime? @map("vigencia_fim")
  criadoEm       DateTime  @default(now()) @map("criado_em")

  // Prazo estruturado em meses (10 ou 24, ver fluxo de convite nominal) —
  // null continua valendo pros contratos "texto livre" antigos, sem prazo
  // definido.
  prazoMeses Int? @map("prazo_meses")

  // Assinatura eletrônica SIMPLES (aceite dentro do próprio app — checkbox +
  // clique — sem provedor terceirizado de assinatura qualificada; decisão
  // registrada no plano de implantação). `textoContrato` é o snapshot do
  // texto exibido no momento da assinatura e `assinadoHash` é o SHA-256
  // desse texto, só pra provar depois que ele não foi alterado após
  // assinado. Todos nulos = contrato ainda não assinado (ou registro
  // antigo, anterior a essa funcionalidade).
  textoContrato     String?   @map("texto_contrato")
  assinadoEm        DateTime? @map("assinado_em")
  assinadoIp        String?   @map("assinado_ip")
  assinadoUserAgent String?   @map("assinado_user_agent")
  assinadoHash      String?   @map("assinado_hash")

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)

  @@index([vinculoId])
  @@map("contratos_transporte")
}

// ---------------------------------------------------------------------------
// EmbarqueDia — marcação do motorista (embarcou / ausente) por aluno, por
// dia, na rota. Só existe uma linha quando o motorista marcou algo — sem
// linha para o dia é o estado "normal" (ainda não passou pela parada).
// ---------------------------------------------------------------------------

model EmbarqueDia {
  id        String            @id @default(cuid())
  vinculoId String            @map("vinculo_id")
  data      DateTime          @db.Date
  // Padrão IDA por retrocompatibilidade — todo registro criado antes da
  // rota de volta existir era, por definição, da ida (a única que existia).
  sentido   SentidoViagem     @default(IDA) @map("sentido")
  status    StatusEmbarqueDia

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)

  @@unique([vinculoId, data, sentido])
  @@map("embarques_dia")
}

// ---------------------------------------------------------------------------
// AlertaProximidade — registra que o alerta sonoro de chegada já foi
// disparado para este vínculo hoje, pra não repetir a cada atualização de
// GPS (12 em 12s) enquanto o motorista estiver dentro do raio configurado.
// ---------------------------------------------------------------------------

model AlertaProximidade {
  id        String   @id @default(cuid())
  vinculoId String   @map("vinculo_id")
  data      DateTime @db.Date
  criadoEm  DateTime @default(now()) @map("criado_em")

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)

  @@unique([vinculoId, data])
  @@map("alertas_proximidade")
}

// ---------------------------------------------------------------------------
// PercursoDia — histórico do trajeto percorrido pelo motorista, encerrado
// pelo botão "Encerrar rota" (RotaPanel.tsx). Guarda um snapshot dos status
// de embarque do dia (embarcaram/ausentes) e a distância percorrida — a
// fonte de dados do relatório diário (src/app/motorista/(app)/relatorios).
// Não é único por dia: o motorista pode ter mais de um percurso no mesmo
// dia (ida e volta, manhã e tarde etc.), cada um encerrado separadamente.
// ---------------------------------------------------------------------------

model PercursoDia {
  id          String    @id @default(cuid())
  motoristaId String    @map("motorista_id")
  data        DateTime  @db.Date
  iniciadoEm  DateTime  @map("iniciado_em")
  encerradoEm DateTime? @map("encerrado_em")

  totalAlunos     Int   @default(0) @map("total_alunos")
  totalEmbarcaram Int   @default(0) @map("total_embarcaram")
  totalAusentes   Int   @default(0) @map("total_ausentes")
  distanciaMetros Float? @map("distancia_metros")

  criadoEm DateTime @default(now()) @map("criado_em")

  motorista Motorista       @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  pontos    PercursoPonto[]

  @@index([motoristaId, data])
  @@map("percursos_dia")
}

model PercursoPonto {
  id         String   @id @default(cuid())
  percursoId String   @map("percurso_id")
  latitude   Float
  longitude  Float
  criadoEm   DateTime @default(now()) @map("criado_em")

  percurso PercursoDia @relation(fields: [percursoId], references: [id], onDelete: Cascade)

  @@index([percursoId, criadoEm])
  @@map("percurso_pontos")
}

// ---------------------------------------------------------------------------
// Localizacao (1:1 com Motorista)
// ---------------------------------------------------------------------------

model Localizacao {
  motoristaId String   @id @map("motorista_id")
  latitude    Float
  longitude   Float
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  motorista Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)

  @@map("localizacoes")
}

// ---------------------------------------------------------------------------
// PlanoAssinatura — catálogo de planos (Basic/Pró/Max, e quaisquer outros
// que o admin criar) editável pelo painel administrativo. É a fonte de
// verdade única: tanto o preview de preço no motorista quanto o cálculo no
// servidor leem daqui (`src/lib/subscription/planos-service.ts`), então uma
// alteração/criação/remoção feita pelo admin aparece imediatamente para os
// motoristas. `ativo = false` esconde o plano da vitrine sem apagar
// histórico; a remoção definitiva só é permitida quando nenhuma Assinatura
// referencia o `codigo` (ver `excluirPlano`).
// ---------------------------------------------------------------------------

model PlanoAssinatura {
  id                     String                  @id @default(cuid())
  codigo                 String                  @unique
  label                  String
  // Historicamente também podia ser oferecido ao responsável (cobrança
  // direta por aluno) — esse modelo foi removido (agora é o MOTORISTA quem
  // paga por aluno vinculado, ver `CobrancaAluno`). O enum `PublicoPlano`
  // mantém o valor RESPONSAVEL só por compatibilidade de dados antigos; o
  // formulário admin (`PlanoForm.tsx`) só oferece MOTORISTA hoje.
  publico                PublicoPlano            @default(MOTORISTA)
  cicloCobranca          CicloCobrancaAssinatura @map("ciclo_cobranca")
  cicloLabel             String                  @map("ciclo_label")
  valorBase              Decimal                 @db.Decimal(10, 2) @map("valor_base")
  alunosGratis           Int                     @default(0) @map("alunos_gratis")
  valorPorAlunoExcedente Decimal                 @default(0) @db.Decimal(10, 2) @map("valor_por_aluno_excedente")
  recursos               Json                    @default("[]") // string[]
  permiteAnosAdicionais  Boolean                 @default(false) @map("permite_anos_adicionais")
  destaque               String?
  ativo                  Boolean                 @default(true)
  ordem                  Int                     @default(0)
  criadoEm               DateTime                @default(now()) @map("criado_em")
  atualizadoEm           DateTime                @updatedAt @map("atualizado_em")

  @@map("planos_assinatura")
}

// ---------------------------------------------------------------------------
// Assinatura — plano pago pré-pago que o motorista escolhe (catálogo em
// PlanoAssinatura, mantido pelo admin). Ao escolher um plano, entra em teste
// por 7 dias (TESTE); o pagamento via Mercado Pago ativa o ciclo pago
// (ATIVA) até `expiraEm`. Cada motorista pode ter várias linhas ao longo do
// tempo (histórico de trocas/renovações) — a assinatura "atual" é sempre a
// mais recente por `criadoEm`.
// ---------------------------------------------------------------------------

model Assinatura {
  id                   String                  @id @default(cuid())
  motoristaId          String                  @map("motorista_id")
  // Snapshot do plano no momento da contratação: guardamos o código (livre,
  // não é mais um enum fixo — planos são criados/editados/removidos pelo
  // admin) e o rótulo, para que o histórico continue legível mesmo que o
  // plano original seja renomeado ou excluído depois.
  tipoPlano            String                  @map("tipo_plano")
  planoLabel           String                  @default("") @map("plano_label")
  cicloCobranca        CicloCobrancaAssinatura @map("ciclo_cobranca")
  qtdAlunosContratados Int                     @map("qtd_alunos_contratados")
  anosAdicionais       Int                     @default(0) @map("anos_adicionais") // só planos com permiteAnosAdicionais

  // Composição do valor cobrado — guardada explicitamente (não só o total)
  // para o histórico/recibo mostrar o desconto de alunos grátis aplicado.
  valorPlano            Decimal @db.Decimal(10, 2) @map("valor_plano")
  valorAlunosExcedentes Decimal @db.Decimal(10, 2) @map("valor_alunos_excedentes")
  valorAnosAdicionais   Decimal @default(0) @db.Decimal(10, 2) @map("valor_anos_adicionais")
  valorTotal            Decimal @db.Decimal(10, 2) @map("valor_total")

  // Snapshot do plano (mesmo espírito de `planoLabel`/`valorPlano` acima —
  // não muda retroativamente se o admin editar o plano depois) usado pelo
  // motor de cobrança por aluno (ver `CobrancaAluno` e
  // src/lib/subscription/cobranca-aluno.ts): quantos alunos vinculados ATIVOS
  // ficam de fora da cobrança (os N mais antigos) e quanto custa cada aluno
  // excedente por ciclo de 30 dias. Copiado de `PlanoAssinatura.alunosGratis`/
  // `valorPorAlunoExcedente` no momento em que a assinatura é criada/ativada.
  alunosGratis           Int     @default(0) @map("alunos_gratis")
  valorPorAlunoExcedente Decimal @default(0) @db.Decimal(10, 2) @map("valor_por_aluno_excedente")

  status          StatusAssinatura @default(TESTE)
  testeExpiraEm   DateTime         @map("teste_expira_em")
  inicioEm        DateTime?        @map("inicio_em")
  expiraEm        DateTime?        @map("expira_em")
  criadoEm        DateTime         @default(now()) @map("criado_em")

  motorista  Motorista   @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  pagamentos Pagamento[]

  @@index([motoristaId, criadoEm])
  @@index([tipoPlano])
  @@map("assinaturas")
}

// ---------------------------------------------------------------------------
// Pagamento — cada tentativa/registro de cobrança no Mercado Pago para uma
// Assinatura. O status nunca é gravado a partir do corpo do webhook
// diretamente: o webhook só avisa "algo mudou", e o servidor sempre
// reconsulta o pagamento na API do Mercado Pago antes de confiar nele.
// ---------------------------------------------------------------------------

model Pagamento {
  id                  String          @id @default(cuid())
  // Preenchido quando este Pagamento é da mensalidade da plataforma. Um
  // Pagamento "de cobrança por aluno" não tem uma FK escalar aqui — em vez
  // disso é dono de várias `CobrancaAluno` (ver relação abaixo e comentário
  // no model CobrancaAluno) porque a Asaas exige valor mínimo de R$5,00 por
  // cobrança e o valor por aluno excedente costuma ser bem menor, então
  // várias cobranças pendentes do mesmo motorista são agrupadas num Pagamento
  // só (ver src/lib/subscription/cobranca-aluno-pagamento.ts).
  assinaturaId        String?         @map("assinatura_id")
  gateway             String          @default("mercadopago")
  gatewayPagamentoId  String?         @unique @map("gateway_pagamento_id")
  gatewayPreferenceId String?         @map("gateway_preference_id")
  valor               Decimal         @db.Decimal(10, 2)
  status              StatusPagamento @default(PENDENTE)
  checkoutUrl         String?         @map("checkout_url")
  criadoEm            DateTime        @default(now()) @map("criado_em")
  pagoEm              DateTime?       @map("pago_em")

  assinatura     Assinatura?     @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)
  cobrancasAluno CobrancaAluno[]

  @@map("pagamentos")
}

// ---------------------------------------------------------------------------
// CobrancaAluno — cobrança do MOTORISTA por um aluno vinculado, gerada pelo
// cron de 30 em 30 dias de vínculo ATIVO (ver
// src/lib/subscription/cobranca-aluno.ts). É o motorista quem paga por aluno
// excedente (além da faixa grátis do plano dele — SEMESTRAL/ANUAL), e paga
// direto pela plataforma via Asaas (mesmo gateway já usado pra mensalidade).
// Como a Asaas recusa cobrança abaixo de R$5,00 e o valor por aluno costuma
// ser bem menor, várias CobrancaAluno PENDENTE do mesmo motorista são
// agrupadas num único `Pagamento` na hora de gerar o link (ver
// `pagamentoId` abaixo e src/lib/subscription/cobranca-aluno-pagamento.ts):
// PENDENTE até a Asaas confirmar o pagamento (webhook + sincronização), ou
// CANCELADO se decidir não cobrar.
// ---------------------------------------------------------------------------

model CobrancaAluno {
  id          String   @id @default(cuid())
  vinculoId   String   @map("vinculo_id")
  // Redundante com `vinculo.motoristaId` de propósito — permite listar todas
  // as cobranças de um motorista (`/motorista/vinculos`) sem precisar de
  // join, e sobrevive caso o vínculo seja excluído (não é: onDelete Cascade
  // também apaga a cobrança, mas mantém a consulta simples de qualquer jeito).
  motoristaId String   @map("motorista_id")
  cicloInicio DateTime @map("ciclo_inicio")
  cicloFim    DateTime @map("ciclo_fim")
  valor       Decimal  @db.Decimal(10, 2)
  status      StatusCobrancaAluno @default(PENDENTE)
  pagoEm      DateTime? @map("pago_em")
  criadoEm    DateTime @default(now()) @map("criado_em")
  // Última tentativa de pagamento Asaas que incluiu essa cobrança — sempre
  // reescrita a cada novo checkout gerado (não há reaproveitamento de link
  // entre tentativas, mesmo padrão simples já usado no checkout de
  // assinatura). Null até o motorista clicar em "Pagar" pela primeira vez;
  // onDelete SetNull porque a cobrança (a dívida em si) sobrevive mesmo se o
  // registro do Pagamento for removido.
  pagamentoId String?  @map("pagamento_id")

  vinculo   Vinculo    @relation(fields: [vinculoId], references: [id], onDelete: Cascade)
  motorista Motorista  @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  pagamento Pagamento? @relation(fields: [pagamentoId], references: [id], onDelete: SetNull)

  @@index([motoristaId, status])
  @@index([vinculoId, cicloInicio])
  @@index([pagamentoId])
  @@map("cobrancas_aluno")
}

// ---------------------------------------------------------------------------
// TentativaAcesso — registro cru de cada tentativa de login (motorista,
// responsável, admin), usado só para rate limiting (ver src/lib/rate-limit.ts).
// Linhas somem sozinhas na limpeza diária (ver /api/cron/limpeza) — não tem
// valor nenhum depois da janela de contagem (15 min).
// ---------------------------------------------------------------------------

model TentativaAcesso {
  id       String   @id @default(cuid())
  // Ex: "login:motorista:fulano@x.com" ou "login:admin:ip:187.1.2.3" — uma
  // linha por combinação de escopo+identificador+tentativa, contada dentro
  // de uma janela de tempo curta.
  chave    String
  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([chave, criadoEm])
  @@map("tentativas_acesso")
}

// ---------------------------------------------------------------------------
// CodigoVerificacao — código de 6 dígitos enviado por e-mail, usado tanto
// para confirmar o cadastro (a conta só é criada depois de validado) quanto
// como segundo fator obrigatório em todo login.
// ---------------------------------------------------------------------------

model CodigoVerificacao {
  id         String    @id @default(cuid())
  email      String
  role       String // "motorista" | "responsavel"
  proposito  String // "CADASTRO" | "LOGIN"
  codigoHash String    @map("codigo_hash")
  tentativas Int       @default(0)

  // Dados do cadastro pendente (nome/telefone/senhaHash), guardados aqui só
  // quando proposito = CADASTRO — a conta em si não existe até o código ser
  // confirmado, então não há onde mais guardar isso nesse meio-tempo.
  payload Json?

  criadoEm DateTime  @default(now()) @map("criado_em")
  expiraEm DateTime  @map("expira_em")
  usadoEm  DateTime? @map("usado_em")

  @@index([email, role, proposito, usadoEm])
  @@map("codigos_verificacao")
}

// ---------------------------------------------------------------------------
// GeocodeCache — resultado de geocodificação já resolvido antes, guardado
// por uma chave normalizada do endereço (rua+número+bairro+cidade+UF+CEP),
// pra nunca pagar (nem gastar cota grátis de) LocationIQ/Nominatim/Google
// duas vezes pelo MESMO endereço — nem entre cadastros diferentes (dois
// alunos no mesmo prédio, duas escolas com o mesmo endereço de referência)
// nem no mesmo registro sendo salvo de novo sem mudar o endereço de fato.
// Ver `geocodeEndereco` em src/lib/geocoding.ts, que consulta isso ANTES de
// chamar qualquer provedor externo. TTL de 180 dias (ver CACHE_TTL_DIAS) —
// depois disso vira cache miss e busca de novo (e reescreve a entrada),
// tempo generoso porque a coordenada de um endereço não muda na prática,
// mas evita guardar pra sempre algo que nunca mais vai ser consultado.
// ---------------------------------------------------------------------------

model GeocodeCache {
  id String @id @default(cuid())

  // Normalizada (sem acento/maiúsculas) e única — ver `chaveCache` em
  // src/lib/geocoding.ts. Não é o endereço "bonito", é só a chave de busca.
  chave String @unique

  latitude           Float
  longitude          Float
  enderecoEncontrado String? @map("endereco_encontrado")
  // "alta" | "baixa" — mesmo significado de GeocodeResult.precisao.
  precisao String?

  criadoEm    DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("geocode_cache")
}

// ---------------------------------------------------------------------------
// UsoApiExterna — registro cru de cada chamada às APIs pagas do Google
// (Geocoding, Places Autocomplete, Routes/Directions), usado só para o
// painel admin mostrar quanto do limite gratuito mensal (~10.000 chamadas
// cada) já foi consumido em cada uma — ver src/lib/uso-api-externa.ts e a
// página /admin/uso-google. Mesma ideia de "uma linha por evento, contada
// dentro de uma janela" que TentativaAcesso, só que a janela aqui é o mês
// corrente (calendário) em vez de minutos. Linhas somem sozinhas na limpeza
// diária (ver /api/cron/limpeza) — não têm valor depois de ~40 dias, já que
// só contamos o mês corrente.
// ---------------------------------------------------------------------------

model UsoApiExterna {
  id String @id @default(cuid())

  // "geocoding" | "places_autocomplete" | "routes_directions" — ver
  // ApiExterna em src/lib/uso-api-externa.ts.
  api      String
  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([api, criadoEm])
  @@map("uso_api_externa")
}

// ---------------------------------------------------------------------------
// LogAuditoria — trilha de ações sensíveis feitas no painel admin (suspender/
// reativar conta, excluir motorista/responsável, forçar assinatura, criar/
// editar/ativar/excluir plano, login). Não há tabela de admins — a
// credencial é única e fixa (ADMIN_EMAIL/ADMIN_SENHA) — então todo registro
// aqui é sempre do mesmo "ator"; o valor de `acao` e `detalhes` é que conta
// a história de quem fez o quê.
// ---------------------------------------------------------------------------

model LogAuditoria {
  id         String   @id @default(cuid())
  acao       String
  entidade   String
  entidadeId String?  @map("entidade_id")
  detalhes   Json?
  ip         String?
  criadoEm   DateTime @default(now()) @map("criado_em")

  @@index([criadoEm])
  @@index([entidade, entidadeId])
  @@map("logs_auditoria")
}
