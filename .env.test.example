# Copie este arquivo para ".env.test" (ignorado pelo git, mesmo padrão do
# ".env"/".env.example") pra rodar os testes de integração
# (`npm run test:integration`) contra o Postgres de teste dedicado
# (ver docker-compose.test.yml — NÃO é o mesmo banco do docker-compose.yml
# de desenvolvimento).
#
# É "DATABASE_URL" mesmo (não uma variável separada tipo TEST_DATABASE_URL):
# tanto os fixtures dos testes quanto o código de produção sob teste
# (ex.: processarCobrancasAlunoVencidas) usam o mesmo cliente Prisma
# (`@/lib/prisma`), então precisam enxergar o mesmo banco — é essa variável
# que muda entre "rodando o app" e "rodando os testes de integração".
#
#   docker compose -f docker-compose.test.yml up -d
#   cp .env.test.example .env.test
#   npm run test:integration:migrate   # só na 1a vez / após mudar o schema
#   npm run test:integration

DATABASE_URL="postgresql://moove_test:moove_test@localhost:5434/moove_test?schema=public"
