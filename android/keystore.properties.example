# Copie para "android/keystore.properties" (ignorado pelo git) — NUNCA
# commite a keystore de verdade nem as senhas reais.
#
# Como gerar sua própria keystore de upload (se não tiver uma ainda):
#   keytool -genkeypair -v -keystore upload-keystore.jks -alias moove-upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Formato PKCS12 (padrão atual do keytool): storePassword e keyPassword
# são sempre a MESMA senha — o formato não suporta senhas diferentes.
storeFile=upload-keystore.jks
storePassword=coloque-a-senha-aqui
keyAlias=moove-upload
keyPassword=coloque-a-senha-aqui
