# Banco de dados PostgreSQL
DATABASE_URL="postgresql://moove:moove@localhost:5432/moove?schema=public"

# Geocodificação de endereço → coordenada (ver src/lib/geocoding.ts).
# LocationIQ (https://locationiq.com) — gratuito até 5.000 requisições/dia.
# Sem essa chave, o sistema cai direto no Nominatim público (mais sujeito a
# bloqueio/limitação vindo de servidor/nuvem) como única fonte gratuita.
LOCATIONIQ_API_KEY=""
# Opcional e PAGA: Google Geocoding API — usada só como fallback quando as
# fontes gratuitas (LocationIQ/Nominatim/BrasilAPI) não encontram o
# endereço, comum em condomínios/loteamentos fechados mal mapeados no
# OpenStreetMap. 10.000 chamadas grátis/mês, depois USD 5 a cada 1.000 (veja
# preços atuais em https://mapsplatform.google.com/pricing/). Exige criar um
# projeto no Google Cloud Console, ativar a "Geocoding API", cadastrar um
# cartão e gerar a chave em APIs & Services > Credentials. Sem essa env var,
# essa etapa é simplesmente pulada — nada quebra.
GOOGLE_MAPS_GEOCODING_API_KEY=""

# Opcional e PAGA: Google Routes API (computeRoutes) — usada só como
# fallback quando o OSRM gratuito (src/lib/routing/osrm.ts) falha ao
# calcular a rota, e só no painel do motorista (nunca no polling de
# localização do responsável, onde a frequência não compensa o custo). Por
# padrão reaproveita a mesma chave acima — só é preciso também habilitar a
# "Routes API" no mesmo projeto do Google Cloud. Se preferir uma chave
# separada por API, defina esta aqui. 10.000 chamadas grátis/mês, depois USD
# 5 a cada 1.000. Sem nenhuma das duas chaves, o fallback é pulado — a rota
# só falha se o OSRM também falhar.
GOOGLE_MAPS_DIRECTIONS_API_KEY=""

# Opcional: Google Places Autocomplete (New API) no formulário de endereço
# (busca por texto livre, ex: "Avenida Resedá 235 Cajamar"). Diferente das
# chaves acima (uso só no servidor): esta roda no NAVEGADOR do usuário, por
# isso precisa do prefixo NEXT_PUBLIC_ e DEVE ser restrita por "HTTP
# referrers" no Google Cloud Console ao(s) domínio(s) da aplicação (nunca
# deixe uma chave client-side sem essa restrição). Ative "Places API (New)"
# no projeto. 10.000 sessões grátis/mês (ver comentário no componente
# GoogleEnderecoAutocomplete.tsx sobre como isso fica praticamente grátis).
# Sem essa chave, o campo de busca simplesmente não aparece — o formulário
# continua 100% funcional via CEP ou preenchimento manual.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""

# Segredos usados para assinar as sessões (JWT) de Motorista e Responsavel.
# Gere valores fortes e distintos, por ex: `openssl rand -base64 48`
AUTH_SECRET_MOTORISTA="troque-por-um-segredo-forte-e-aleatorio"
AUTH_SECRET_RESPONSAVEL="troque-por-outro-segredo-forte-e-aleatorio"
AUTH_SECRET_ADMIN="troque-por-outro-segredo-forte-e-aleatorio"

# Credenciais fixas do painel administrativo (/admin) — gerenciar motoristas
# e responsáveis (suspender, excluir, ver/forçar assinaturas). Sem tabela no
# banco: é uma credencial única, definida aqui.
ADMIN_EMAIL="admin@seudominio.com"
ADMIN_SENHA="troque-por-uma-senha-forte"

# Storage de documentos do veículo (compatível com S3 — AWS S3, Cloudflare R2, etc.)
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="moove-documentos"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# URL pública (opcional) se o bucket/CDN expuser os arquivos publicamente.
# Se vazio, o sistema gera URLs assinadas (signed URLs) sob demanda.
STORAGE_PUBLIC_BASE_URL=""

# Faixa de referência de cobrança por aluno excedente (5º em diante), em BRL.
BILLING_VALOR_POR_ALUNO_EXCEDENTE="6.00"
BILLING_ALUNOS_INCLUIDOS_GRATIS="5"

# Segredo compartilhado para autorizar o cron diário de limpeza
# (GET /api/cron/limpeza — poda pontos de GPS antigos, fecha percursos
# esquecidos abertos, limpa tentativas de login e códigos de verificação
# expirados). A Vercel injeta o header "Authorization: Bearer <CRON_SECRET>"
# sozinha nas chamadas agendadas em vercel.json quando essa env var existe.
CRON_SECRET="troque-por-um-segredo-forte-e-aleatorio"
# Opcional: por quantos dias manter o rastro detalhado de GPS (lat/lon ponto
# a ponto) antes de apagar — os agregados do dia (distância, embarcaram/
# ausentes) continuam pra sempre. Padrão: 90 dias.
GPS_RETENCAO_DIAS="90"

# Verificação por e-mail (cadastro e login) via Resend (https://resend.com —
# plano gratuito: 100 e-mails/dia, 3000/mês). Sem essa chave, o código de
# verificação é apenas impresso no log do servidor (bom para dev local).
RESEND_API_KEY=""
EMAIL_FROM="Moove <onboarding@resend.dev>"

# URL pública da aplicação (sem barra no final) — usada para montar as URLs
# de retorno e de notificação (webhook) do checkout do Mercado Pago.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gateway de pagamento (Asaas) para assinatura dos planos Basic/Pró/Max.
# Chave de API em https://www.asaas.com/ > Integrações > API. Sem essa
# variável, o checkout falha com "Pagamento ainda não está configurado
# neste ambiente (ASAAS_API_KEY)." — precisa ser definida tanto localmente
# quanto nas variáveis de ambiente da Vercel (Production e Preview).
ASAAS_API_KEY=""
# "true" usa a API de sandbox (https://sandbox.asaas.com) — a chave usada
# precisa bater com o ambiente (chave de produção não funciona no sandbox e
# vice-versa). Deixe em branco ou "false" para produção.
ASAAS_SANDBOX="false"
# Secret próprio do Moove — precisa ser IGUAL ao "Token de autenticação"
# configurado ao cadastrar o webhook do Moove no painel da Asaas
# (Integrações > Webhooks). A mesma conta Asaas pode ter outros webhooks de
# outros projetos, cada um com seu próprio token; esse aqui só valida o
# webhook do Moove.
ASAAS_WEBHOOK_TOKEN=""

# Web Push (alerta sonoro de proximidade do responsável) — par de chaves só
# do Moove, sem depender de conta em serviço nenhum. Gere com:
# `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@seudominio.com"
# Mesma chave pública acima — precisa do prefixo NEXT_PUBLIC_ pra ficar
# disponível no navegador (usada pra inscrever o responsável no push).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Monitoramento de erro em produção (Sentry — https://sentry.io, plano
# gratuito cobre bem o início). Sem essas variáveis o SDK fica desabilitado
# (não envia nada, não quebra o build) — crie um projeto Next.js no Sentry e
# copie o DSN dele nos dois campos abaixo (mesmo valor nos dois).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Opcionais — só necessários para o upload de source maps (stack traces
# legíveis em produção). Gere o token em Settings > Auth Tokens no Sentry.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
